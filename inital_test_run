<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TalkBridge — quick prototype</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F7F6F2;
    --card: #FFFFFF;
    --ink: #24231F;
    --muted: #7A786F;
    --source: #C7415A;
    --source-dim: #F8E3E7;
    --target: #1D6E78;
    --target-dim: #DFEFEF;
    --bridge: #2B2B3D;
    --radius: 16px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .app { max-width: 440px; margin: 0 auto; padding: 32px 20px 40px; }
  header { text-align: center; margin-bottom: 26px; }
  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 30px;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
    color: var(--bridge);
  }
  .tagline { margin: 0; color: var(--muted); font-size: 14px; }
  .lang-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 8px;
    align-items: end;
    margin-bottom: 6px;
  }
  .lang-pill { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .lang-pill label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .lang-pill.source label { color: var(--source); }
  .lang-pill.target label { color: var(--target); }
  select {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    padding: 10px;
    border-radius: 12px;
    border: 1.5px solid transparent;
    background: var(--source-dim);
    color: var(--ink);
    width: 100%;
  }
  .lang-pill.target select { background: var(--target-dim); }
  select:focus-visible, button:focus-visible, input:focus-visible {
    outline: 2px solid var(--bridge);
    outline-offset: 2px;
  }
  .swap-btn {
    width: 36px; height: 36px;
    border-radius: 50%;
    border: none;
    background: var(--bridge);
    color: #fff;
    font-size: 16px;
    cursor: pointer;
    margin-bottom: 2px;
  }
  .bridge-track { position: relative; height: 4px; margin: 6px 30px 24px; border-radius: 2px; }
  .bridge-line {
    position: absolute; inset: 0; border-radius: 2px;
    background: linear-gradient(90deg, var(--source), var(--bridge) 50%, var(--target));
    opacity: 0.4;
  }
  .bridge-dot {
    position: absolute; top: 50%; left: 0;
    width: 10px; height: 10px; margin-top: -5px;
    border-radius: 50%;
    background: var(--bridge);
    box-shadow: 0 0 0 4px var(--bg);
    transition: left 0.9s cubic-bezier(.4,0,.2,1);
  }
  .bridge-dot.at-end { left: calc(100% - 10px); }
  .mic-wrap { display: flex; justify-content: center; margin: 8px 0 14px; }
  .mic-btn {
    width: 84px; height: 84px;
    border-radius: 50%;
    border: none;
    background: var(--bridge);
    color: #fff;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .mic-btn:disabled { opacity: 0.5; cursor: default; }
  @media (prefers-reduced-motion: no-preference) {
    .mic-btn.listening { animation: pulse-ring 1.4s ease-out infinite; }
  }
  .mic-btn.listening { background: var(--source); }
  @keyframes pulse-ring {
    0% { box-shadow: 0 0 0 0 rgba(199,65,90,0.35); }
    70% { box-shadow: 0 0 0 20px rgba(199,65,90,0); }
    100% { box-shadow: 0 0 0 0 rgba(199,65,90,0); }
  }
  .status { text-align: center; font-size: 14px; color: var(--muted); min-height: 20px; margin: 0 0 18px; }
  .type-row { display: flex; gap: 8px; margin-bottom: 22px; }
  .type-row input {
    flex: 1;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1.5px solid #E4E2DA;
    background: var(--card);
    min-width: 0;
  }
  .type-row button {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    padding: 10px 14px;
    border-radius: 10px;
    border: none;
    background: var(--ink);
    color: #fff;
    cursor: pointer;
  }
  .card {
    background: var(--card);
    border-radius: var(--radius);
    padding: 16px 18px;
    margin-bottom: 12px;
    border-left: 4px solid transparent;
  }
  .card.source-card { border-left-color: var(--source); }
  .card.target-card { border-left-color: var(--target); }
  .card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .card-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .card p { margin: 0; font-size: 17px; line-height: 1.5; word-break: break-word; }
  .speaker-btn {
    width: 34px; height: 34px;
    border-radius: 50%;
    border: none;
    background: var(--target-dim);
    color: var(--target);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }
  .speaker-btn:hover { background: var(--target); color: #fff; }
  .footnote { text-align: center; font-size: 12px; color: var(--muted); margin-top: 24px; }
  @media (max-width: 340px) {
    .lang-row { grid-template-columns: 1fr; }
    .swap-btn { justify-self: center; margin: 4px 0; }
  }
</style>
</head>
<body>
<div class="app">
  <header>
    <h1>TalkBridge</h1>
    <p class="tagline">Speak. They hear it in their language.</p>
  </header>

  <div class="lang-row">
    <div class="lang-pill source">
      <label for="sourceLang">You speak</label>
      <select id="sourceLang"></select>
    </div>
    <button class="swap-btn" id="swapBtn" aria-label="Swap languages" type="button">⇄</button>
    <div class="lang-pill target">
      <label for="targetLang">They understand</label>
      <select id="targetLang"></select>
    </div>
  </div>

  <div class="bridge-track" aria-hidden="true">
    <span class="bridge-line"></span>
    <span class="bridge-dot" id="bridgeDot"></span>
  </div>

  <div class="mic-wrap">
    <button class="mic-btn" id="micBtn" type="button" aria-label="Tap to speak">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
        <rect x="9" y="2" width="6" height="12" rx="3" fill="currentColor"/>
        <path d="M5 11a7 7 0 0 0 14 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
        <line x1="12" y1="18" x2="12" y2="22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <line x1="8" y1="22" x2="16" y2="22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <p class="status" id="status" aria-live="polite">Loading…</p>

  <div class="type-row">
    <input id="typeInput" type="text" placeholder="Or type a sentence instead…">
    <button id="typeBtn" type="button">Translate</button>
  </div>

  <div class="card source-card">
    <span class="card-label">You said</span>
    <p id="transcriptText">—</p>
  </div>

  <div class="card target-card">
    <div class="card-head">
      <span class="card-label">Translation</span>
      <button class="speaker-btn" id="playBtn" type="button" hidden aria-label="Play translation aloud">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/>
          <path d="M16.5 8.5a5 5 0 0 1 0 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
          <path d="M19 6a9 9 0 0 1 0 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
        </svg>
      </button>
    </div>
    <p id="translationText">—</p>
  </div>

  <p class="footnote">Quick prototype for testing the idea — works best in Chrome. Translation uses a free service as a stand-in for testing, not final quality.</p>
</div>

<script>
(function () {
  var LANGS = [
    { code: 'hi-IN', tcode: 'hi',    label: 'Hindi' },
    { code: 'en-US', tcode: 'en',    label: 'English' },
    { code: 'ja-JP', tcode: 'ja',    label: 'Japanese' },
    { code: 'es-ES', tcode: 'es',    label: 'Spanish' },
    { code: 'fr-FR', tcode: 'fr',    label: 'French' },
    { code: 'de-DE', tcode: 'de',    label: 'German' },
    { code: 'zh-CN', tcode: 'zh-CN', label: 'Chinese (Mandarin)' },
    { code: 'ar-SA', tcode: 'ar',    label: 'Arabic' },
    { code: 'pt-BR', tcode: 'pt-BR', label: 'Portuguese' },
    { code: 'ko-KR', tcode: 'ko',    label: 'Korean' },
    { code: 'bn-IN', tcode: 'bn',    label: 'Bengali' },
    { code: 'ta-IN', tcode: 'ta',    label: 'Tamil' },
    { code: 'te-IN', tcode: 'te',    label: 'Telugu' },
    { code: 'mr-IN', tcode: 'mr',    label: 'Marathi' },
    { code: 'ur-PK', tcode: 'ur',    label: 'Urdu' }
  ];

  var sourceSelect = document.getElementById('sourceLang');
  var targetSelect = document.getElementById('targetLang');
  var micBtn = document.getElementById('micBtn');
  var statusEl = document.getElementById('status');
  var transcriptEl = document.getElementById('transcriptText');
  var translationEl = document.getElementById('translationText');
  var playBtn = document.getElementById('playBtn');
  var bridgeDot = document.getElementById('bridgeDot');
  var swapBtn = document.getElementById('swapBtn');
  var typeInput = document.getElementById('typeInput');
  var typeBtn = document.getElementById('typeBtn');

  function populate(sel, defaultCode) {
    LANGS.forEach(function (l) {
      var opt = document.createElement('option');
      opt.value = l.code;
      opt.textContent = l.label;
      if (l.code === defaultCode) opt.selected = true;
      sel.appendChild(opt);
    });
  }
  populate(sourceSelect, 'hi-IN');
  populate(targetSelect, 'en-US');

  function findLang(code) {
    for (var i = 0; i < LANGS.length; i++) { if (LANGS[i].code === code) return LANGS[i]; }
    return null;
  }

  var lastTranslation = '';
  var lastTargetCode = targetSelect.value;

  function setStatus(text) { statusEl.textContent = text; }

  function resetBridge() {
    bridgeDot.classList.remove('at-end');
    void bridgeDot.offsetWidth;
  }
  function completeBridge() { bridgeDot.classList.add('at-end'); }

  function speak(text, langCode) {
    if (!('speechSynthesis' in window)) {
      setStatus("Can't play audio aloud in this browser — see the text above.");
      return;
    }
    var utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = langCode;
    utterance.onstart = function () { setStatus('Playing translation…'); };
    utterance.onend = function () { setStatus('Tap the mic and say something'); };
    utterance.onerror = function () { setStatus('Tap the mic and say something'); };
    speechSynthesis.cancel();
    speechSynthesis.speak(utterance);
  }

  function translateText(text, fromTcode, toTcode) {
    var params = new URLSearchParams({ q: text.slice(0, 480), langpair: fromTcode + '|' + toTcode });
    return fetch('https://api.mymemory.translated.net/get?' + params.toString())
      .then(function (response) {
        if (!response.ok) { throw new Error('Request failed: ' + response.status); }
        return response.json();
      })
      .then(function (data) {
        if (!data || data.responseStatus !== 200 || !data.responseData || !data.responseData.translatedText) {
          throw new Error((data && data.responseDetails) || 'Translation failed');
        }
        return data.responseData.translatedText;
      });
  }

  function handleUtterance(text) {
    if (!text || !text.trim()) { return; }
    transcriptEl.textContent = text;
    translationEl.textContent = '—';
    playBtn.hidden = true;
    resetBridge();
    setStatus('Translating…');
    micBtn.disabled = true;
    var fromLang = findLang(sourceSelect.value);
    var toLang = findLang(targetSelect.value);
    translateText(text, fromLang ? fromLang.tcode : 'en', toLang ? toLang.tcode : 'en')
      .then(function (translated) {
        translationEl.textContent = translated;
        lastTranslation = translated;
        lastTargetCode = targetSelect.value;
        completeBridge();
        playBtn.hidden = false;
        setStatus('Translated — tap the speaker to hear it');
      })
      .catch(function () {
        setStatus('Translation failed — check your connection and try again.');
      })
      .then(function () { micBtn.disabled = false; });
  }

  playBtn.addEventListener('click', function () {
    if (lastTranslation) { speak(lastTranslation, lastTargetCode); }
  });

  swapBtn.addEventListener('click', function () {
    var s = sourceSelect.value;
    sourceSelect.value = targetSelect.value;
    targetSelect.value = s;
  });

  typeBtn.addEventListener('click', function () {
    var text = typeInput.value;
    if (text.trim()) {
      handleUtterance(text);
      typeInput.value = '';
    }
  });
  typeInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { typeBtn.click(); }
  });

  var SpeechRecognitionImpl = window.SpeechRecognition || window.webkitSpeechRecognition;
  var recognition = null;
  var listening = false;

  if (SpeechRecognitionImpl) {
    recognition = new SpeechRecognitionImpl();
    recognition.interimResults = false;
    recognition.maxAlternatives = 1;

    recognition.onresult = function (event) {
      var text = event.results[0][0].transcript;
      handleUtterance(text);
    };
    recognition.onerror = function (event) {
      listening = false;
      micBtn.classList.remove('listening');
      if (event.error === 'not-allowed' || event.error === 'service-not-allowed') {
        setStatus('Mic blocked here — download this file and open it directly in Chrome (not inside a chat preview), then try again.');
      } else if (event.error === 'audio-capture') {
        setStatus('No microphone found — check one is connected and not already in use.');
      } else if (event.error === 'no-speech') {
        setStatus("Didn't catch that — tap the mic and try again.");
      } else if (event.error === 'network') {
        setStatus('Network hiccup during listening — check your connection and try again.');
      } else {
        setStatus('Mic error (' + event.error + ') — tap the mic and try again.');
      }
    };
    recognition.onend = function () {
      listening = false;
      micBtn.classList.remove('listening');
    };

    micBtn.addEventListener('click', function () {
      if (listening) { recognition.stop(); return; }
      recognition.lang = sourceSelect.value;
      transcriptEl.textContent = '—';
      translationEl.textContent = '—';
      playBtn.hidden = true;
      resetBridge();
      try {
        recognition.start();
        listening = true;
        micBtn.classList.add('listening');
        setStatus('Listening…');
      } catch (e) {
        setStatus('Tap the mic and try again.');
      }
    });
    setStatus('Tap the mic and say something');
  } else {
    micBtn.disabled = true;
    micBtn.title = "Speech recognition isn't supported in this browser";
    setStatus("Speech input isn't supported here — try Chrome, or type below instead.");
  }
})();
</script>
</body>
</html>
